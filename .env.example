DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/rustflow
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public path prefix (for example /backend). Empty uses same-origin /api.
VITE_API_BASE_URL=

# Optional RustFlow Assistant; set real values only in the server environment.
RUSTFLOW_LLM_API_KEY=
RUSTFLOW_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Optional server-only token for profile badge activation via the chat command /admin or the /admin page.
# Generate 32 random bytes (openssl rand -hex 32); never publish the result.
RUSTFLOW_ADMIN_TOKEN=

# Optional Google OAuth (Web application, both values are read at server runtime).
# GOOGLE_CLIENT_ID is also accepted as a legacy alias.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact registered URI: https://your-rustflow-host/api/auth/google/callback
GOOGLE_REDIRECT_URI=
