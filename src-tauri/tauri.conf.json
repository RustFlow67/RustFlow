{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHIFT",
  "version": "0.1.0",
  "identifier": "ru.rustflow.desktop",
  "build": {
    "beforeDevCommand": "node scripts/desktop-dev.mjs",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "SHIFT",
        "width": 1280,
        "height": 820,
        "minWidth": 1180,
        "minHeight": 760,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Russian",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
